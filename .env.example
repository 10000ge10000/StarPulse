# StarPulse Environment Variables
# 复制此文件为 .env 并填入你的 GitHub Personal Access Token

# GitHub Personal Access Token
# 建议权限: public_repo（公开仓库权限即可）
# 如需访问私有仓库，请授予相应权限
GH_TOKEN="your_github_token_here"

# 自定义配置（可选）
# 最低 star 门槛（覆盖 config.py 中的默认值）
# MIN_STARS=200

# 自定义运行配置
# STARWORK_LOCALE=zh | en | both (默认 zh)
# STARWORK_LOCALE=zh
